# 카카오 로그인 (Kakao Developers > 내 애플리케이션 > 앱 키)
# JavaScript 키 - 클라이언트 로그인용 (NEXT_PUBLIC_ 필수)
NEXT_PUBLIC_KAKAO_JS_KEY=
# REST API 키 (플랫폼 키) - 서버/토큰 교환용
KAKAO_REST_API_KEY=
# 앱 Admin 키 - 서버 전용 (절대 클라이언트에 노출 금지)
KAKAO_ADMIN_KEY=
# 리다이렉트 URI (선택, 기본: {origin}/auth/kakao/callback)
# NEXT_PUBLIC_KAKAO_REDIRECT_URI=

# ⚠️ Kakao Developers에 리다이렉트 URI 등록 필요:
# - http://localhost:3000/auth/kakao/callback
# - https://kuspba.vercel.app/auth/kakao/callback

# 데이터베이스 (로컬 SQLite 기본값)
DATABASE_URL="file:./dev.db"

# 관리자 로그인 (/admin/login)
# 운영 배포 전 반드시 강한 값으로 변경하세요.
ADMIN_PASSWORD=

# HTTPS 배포면 true, HTTP(IP/포트) 배포면 false
# 비우면 x-forwarded-proto / SITE_URL 기준으로 자동 판단 (기본 false)
# ADMIN_COOKIE_SECURE=false

# 사이트 공개 URL (쿠키 Secure 자동 판단용, 선택)
# NEXT_PUBLIC_SITE_URL=https://example.com

# 업로드 파일 저장 경로 (기본: ./storage/uploads)
# 배포 시 재시작/재배포에도 남기려면 앱 밖 절대경로 권장
# UPLOAD_DIR=/home/ubuntu/apps/kuspba-data/uploads

# 무통장 입금 안내용 계좌 정보 (관리자 설정 또는 환경변수)
# BANK_NAME=
# BANK_ACCOUNT=
# DEPOSIT_HOLDER=
